# Express + MongoDB. Never prefix secrets with VITE_.
MONGODB_URI=mongodb://localhost:27017/invizio

# Supabase Auth (Project Settings → API).
# See docs/SUPABASE.md for a first-time walkthrough.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# JWT Secret from Project Settings → API (server only — never VITE_).
SUPABASE_JWT_SECRET=your-jwt-secret

# Optional comma-separated frontend origins for the Express server.
# CORS_ORIGIN=https://your-frontend.example

# Inventory API origin (no trailing /api/items).
VITE_API_URL=http://localhost:3000
